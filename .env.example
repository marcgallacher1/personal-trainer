# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API). Local dev values are printed by `supabase start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Web Push: optional locally; production uses PROD_VAPID in src/features/settings/push.ts.
VITE_VAPID_PUBLIC_KEY=

# Server-side secrets (set with `supabase secrets set`, NOT here):
#   VAPID_PRIVATE_KEY, VAPID_SUBJECT, ANTHROPIC_API_KEY (optional, for the AI note on weekly reports)

# Optional: ask Claude for a short note on each weekly report (needs ANTHROPIC_API_KEY on the server).
VITE_REPORT_AI=
