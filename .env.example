# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API). Local dev values are printed by `supabase start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Web Push (Phase 4) — public key only; the private key lives in Supabase function secrets.
VITE_VAPID_PUBLIC_KEY=

# Server-side secrets (set with `supabase secrets set`, NOT here):
#   VAPID_PRIVATE_KEY, VAPID_SUBJECT, ANTHROPIC_API_KEY (optional, Phase 6)
